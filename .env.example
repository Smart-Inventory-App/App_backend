# Database
DATABASE_URL=postgresql://user:password@db:5432/tpp_db

# API
API_TITLE=TPP API
API_VERSION=1.0.0
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# CORS (comma-separated)
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:8081,http://localhost:8100,http://localhost:19000

# JWT — debe coincidir con JWT_SECRET del servicio Auth
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256

# SMTP (vacío = solo loguea en consola en dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartinventory.com

# Servidor
HOST=0.0.0.0
PORT=8000
