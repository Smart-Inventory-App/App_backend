# Database
DATABASE_URL=postgresql://user:password@db:5432/tpp_db

# API Config
API_TITLE=TPP API
API_VERSION=1.0.0
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8100,http://localhost:19000,http://10.0.2.2:8000

# JWT (short-lived reset tokens only)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tpp
KEYCLOAK_CLIENT_ID=tpp-app
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-secret

# Email / SMTP (leave SMTP_USER empty to only log codes to console in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartinventory.com

# Firebase
FIREBASE_CREDENTIALS= # string json

# Server
HOST=0.0.0.0
PORT=8000
